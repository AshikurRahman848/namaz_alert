rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Any authenticated user can read & write
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // Groups collection: Authenticated users can create, read, update, delete
    match /groups/{groupId} {
      allow read, write: if request.auth != null;
    }

    // Group Invites: Authenticated users can create and look up invite codes
    match /groupInvites/{inviteCode} {
      allow read, write: if request.auth != null;
    }
  }
}
